  "words.responder": { "text": "답하기", "from": "e99b3cc5" },
  "words.pasa": { "text": "염소 패스!", "from": "c62a8b20" },
  "words.espera": { "text": "문제는 차례인 사람에게만 보여요.", "from": "5cfe6de3" },
  "words.avisoEmpieza": { "text": "{{nombre}} 먼저 시작해요. 행운을 빌어요!", "from": "8ac52822" },
  "words.avisoAcierto": { "text": "좋아요! {{letra}} 정답이에요.", "from": "ba68ad7c" },
  "words.avisoFallo": { "text": "{{letra}} 오답: 정답은 “{{correcta}}”였어요.", "from": "414375ef" },
  "words.avisoSigue": { "text": "{{nombre}} 차례예요.", "from": "e3267ec6" },
  "words.avisoTiempo": { "text": "{{nombre}}의 시간이 끝났어요.", "from": "9e9f7046" },
  "words.avisoRueda": { "text": "{{nombre}}, 바퀴 완주!", "from": "9e03528b" },
  "words.empate": { "text": "무승부!", "from": "5f7e0043" },
  "words.gana": { "text": "{{nombre}} 승리!", "from": "ed43a039" },
  "words.motivos.aciertos": { "text": "더 많이 맞혀서", "from": "6c77ae0b" },
  "words.motivos.fallos": { "text": "맞힌 수는 같지만 덜 틀려서", "from": "bbe57c95" },
  "words.motivos.tiempo": { "text": "맞힌 수와 틀린 수가 같지만 시간이 더 남아서", "from": "da380fd2" },
  "words.motivos.empate": { "text": "맞힌 수, 틀린 수, 남은 시간이 모두 같아요", "from": "59f4abb3" },
  "words.revancha": { "text": "한 판 더", "from": "2170ec2a" },
  "words.cambiar": { "text": "플레이어 바꾸기", "from": "4ab08656" },
  "words.repaso": { "text": "답 보기:", "from": "475280aa" },
  "words.rueda": { "text": "{{nombre}}의 바퀴: 정답 {{bien}}, 오답 {{mal}}, 남은 시간 {{tiempo}}", "from": "42983ecb" },
  "words.sala.abriendo": { "text": "방을 여는 중…", "from": "0b6ee984" },
  "words.sala.anfitrionDesconectado": { "text": "호스트 기기의 연결이 끊겼어요. 다시 연결되기를 기다리는 중…", "from": "fd0736bb" },
  "words.sala.noDisponible": { "text": "온라인 방을 사용할 수 없어요. 호스트가 실시간 편집을 켜고 이 페이지를 Kunobi에서 열어야 해요.", "from": "59c66b52" },
  "words.sala.abrirEnKunobi": { "text": "호스트가 이 페이지를 Kunobi에서 계속 열어 두어야 해요.", "from": "b96ed1ca" },
  "words.sala.reintentar": { "text": "다시 연결하기", "from": "f69b02a9" },
  "words.sala.espectador": { "text": "게임을 구경하고 있어요.", "from": "95afd289" },
  "words.sala.juegasComo": { "text": "{{nombre}}(으)로 플레이 중이에요.", "from": "6e766011" },
  "words.sala.esperandoVuelta": { "text": "상대 플레이어가 돌아오기를 기다리는 중이에요.", "from": "962abc52" },
  "words.sala.espera": { "text": "대기실", "from": "34c061e3" },
  "words.sala.segundoJugador": { "text": "두 번째 플레이어", "from": "f6f5dd1d" },
  "words.sala.invitado": { "text": "게스트", "from": "6c4b85ee" },
  "words.sala.pideUnirse": { "text": "상대 플레이어에게 이 페이지를 Kunobi나 웹 링크로 열고 “친구와 플레이”를 고른 다음 “게임 참가”를 누르라고 알려 주세요.", "from": "2e8a6c8f" },
  "words.sala.enSala": { "text": "방에 들어왔어요. 호스트가 시작하기를 기다리는 중이에요.", "from": "9a291528" },
  "words.sala.unirme": { "text": "게임 참가", "from": "8891cedf" },
  "words.sala.salir": { "text": "대기실 나가기", "from": "fcb8e1f4" },
  "words.sala.soloEspectador": { "text": "구경만 할 수 있는 권한이에요. 플레이하려면 이 스페이스의 플레이어 권한이 필요해요.", "from": "0e22b270" },
  "words.sala.errorCambio": { "text": "방 상태가 바뀌었어요. 차례를 확인하고 다시 시도해 주세요.", "from": "8f4362be" },
  "words.sala.errorActualizar": { "text": "방을 업데이트하지 못했어요. {{motivo}}", "from": "8dcef3a9" },
  "words.sala.vuelveAIntentarlo": { "text": "다시 시도해 주세요.", "from": "7807897c" },
  "words.sala.errorConexion": { "text": "보내는 중에 연결이 끊겼어요. 상태를 확인한 뒤 다시 시도해 주세요.", "from": "da0a7eb5" }
