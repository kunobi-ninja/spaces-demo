{
  "meta.title": { "text": "염소 패스!", "from": "0d12b9d3" },
  "meta.description": { "text": "둘이 하는 단어 게임: 각자 글자 바퀴와 자기 차례에만 가는 시계가 있어요.", "from": "9bfc4b5a" },
  "meta.prompts": { "text": ["스페인어 문제의 Fácil 레벨에 Z 글자 힌트 두 개를 새로 추가해 줘. 답은 다른 것처럼 암호화해 줘.", "플레이어당 시간을 1분, 2분, 4분으로 하고, 마지막 5초에는 카운트다운 소리가 나게 해 줘."], "from": "9ef7f5ed" },
  "words.titulo": { "text": "염소 패스!", "from": "0d12b9d3" },
  "words.gancho": { "text": "글자 바퀴 두 개, 시계 두 개, 그리고 염소 한 마리. 누가 단어를 더 많이 알까요?", "from": "2f751fd3" },
  "words.jugar": { "text": "플레이", "from": "84529b8a" },
  "words.jugarAmigo": { "text": "친구와 플레이", "from": "94b74d09" },
  "words.comoSeJuega": { "text": "게임 방법", "from": "4bffa10e" },
  "words.entendido": { "text": "알겠어요!", "from": "4fa5ec2c" },
  "words.amigoTitulo": { "text": "친구와 함께 하려면", "from": "7111d9f9" },
  "words.amigoTexto": { "text": "먼저 이 게임을 내 것으로 만드세요. 위쪽의 **✨ 내 것으로 만들기**를 탭하고, 내 사본에서 **공유**를 탭해 친구를 초대하세요.", "from": "1c0ae4b4" },
  "words.jugarAqui": { "text": "여기서 플레이", "from": "9eb27f86" },
  "words.cerrar": { "text": "닫기", "from": "4bfd2cbe" },
  "words.volver": { "text": "뒤로", "from": "53677b5d" },
  "words.ajustesTitulo": { "text": "시작하기 전에", "from": "a0999bc0" },
  "words.reglas": { "text": ["글자마다 힌트가 하나 있어요. 답은 그 글자로 시작하거나 그 글자가 들어가요.", "맞혔나요? 계속해서 다음 글자로 가요.", "틀렸나요? 상대 차례예요. 내 시계는 멈추고 상대 시계가 가요.", "모르겠나요? “염소 패스!”라고 말하거나 Esc를 누르세요. 그 글자는 다음 바퀴에 다시 나와요.", "많이 맞힌 사람이 이겨요. 같으면 덜 틀린 사람, 그다음은 시간이 더 남은 사람이에요."], "from": "10a39c8b" },
  "words.tituloEnLinea": { "text": "염소 패스! 온라인", "from": "b527bab7" },
  "words.contra": { "text": "vs", "from": "6cb24c43" },
  "words.jugador": { "text": "플레이어", "from": "9cebe841" },
  "words.tiempo": { "text": "플레이어당 시간", "from": "c098589f" },
  "words.preguntas": { "text": "난이도", "from": "69819395" },
  "words.idiomaPreguntas": { "text": "문제 언어", "from": "cfa95ae8" },
  "words.empezar": { "text": "시작", "from": "3977b0b7" },
