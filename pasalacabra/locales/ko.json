  "words.sonido": { "text": "🔊 소리 켬", "from": "a0d9c9c0" },
  "words.silencio": { "text": "🔇 소리 끔", "from": "eacc6427" },
  "words.cancelarTitulo": { "text": "게임을 취소할까요?", "from": "cda39df4" },
  "words.cancelarAviso": { "text": "지금까지 한 게임은 사라지고 시작 화면으로 돌아가요.", "from": "9e370fa8" },
  "words.cancelarSi": { "text": "네, 취소", "from": "5db5b0cb" },
  "words.no": { "text": "아니요", "from": "15f65b6a" },
  "words.pausaTitulo": { "text": "일시정지됨", "from": "222de08b" },
  "words.pausaAviso": { "text": "시계가 멈췄어요. 다시 시작하면 {{nombre}} 차례예요.", "from": "d88e34ed" },
  "words.seguir": { "text": "계속하기", "from": "e40c0d86" },
