  "words.items.trip": { "text": ["리스본에서 보내는 주말", "친구 둘이 실제 지도에서 3일을 계획해요."], "from": "d6a47420" },
  "words.items.team": { "text": ["Sol Bakery", "팀의 홈: 이번 주, 결정 사항, 위키."], "from": "12ae36bc" },
  "words.items.expenses": { "text": ["공동 생활비", "하우스메이트 네 명의 월세, 공과금, 장보기를 송금 세 번으로 정산해요."], "from": "6acf0c50" },
  "words.items.home-hunt": { "text": ["함께 집 구하기", "두 사람, 각자의 필수 조건, 그리고 둘 다에게 맞는 집."], "from": "5292f10c" },
  "words.items.hiring": { "text": ["나란히 보는 채용", "면접관 의견이 갈리는 곳을 보여줘서 팀이 이야기할 수 있어요."], "from": "1404fd08" },
  "words.items.birthday-film": { "text": ["생일 영상", "추억과 오리지널 노래로 만드는 친구를 위한 30초."], "from": "c42c8b61" },
  "words.items.pitch-deck": { "text": ["시드 피치", "단계별로 나타나고, 멈추고, 휴대폰에도 맞는 슬라이드 10장."], "from": "440f6ca4" },
  "words.items.event": { "text": ["40번째 생일 파티", "주민센터 강당, 작은 예산, 그리고 문제를 찾아내는 자리 배치도."], "from": "52617ff1" },
  "words.items.monthly-report": { "text": ["월간 보고서", "숫자로 설명하는 작은 가게의 한 달."], "from": "567ea8f6" },
  "words.items.meals": { "text": ["이번 주 저녁", "저녁 일곱 끼와 그에 맞춘 장보기 목록."], "from": "458ef47e" },
  "words.items.projects": { "text": ["오픈 준비 보드", "할 일 목록 하나를 보드, 표, 타임라인으로. 카드를 끌어서 옮겨 보세요."], "from": "05ec06c6" },
  "words.items.dino-snack": { "text": ["Dino Snack", "공룡을 좋아하는 아이를 위한 3D 게임."], "from": "44110def" },
  "words.items.content-calendar": { "text": ["콘텐츠 캘린더", "카페의 한 달 치 게시물, 아이디어부터 게시까지."], "from": "a78c5f5a" },
  "words.items.quiz-night": { "text": ["퀴즈의 밤", "내가 만든 문제. 팀마다 자기 화면에서 답하고, 점수가 기록돼요."], "from": "9939ffe2" },
  "words.items.cat-chase": { "text": ["고양이 술래잡기", "모두 자기 고양이를 움직이며 집 안을 돌아다녀요. 물고기를 쫓고 털실을 차요."], "from": "cfd693d2" },
  "words.items.spectral-core": { "text": ["빛을 담다", "유리, 빛, 그리고 커스텀 셰이더."], "from": "178adebf" },
  "words.items.paper-explainer": { "text": ["스텐실 해설", "종이, 잉크, 그리고 들어 올린 오려낸 조각."], "from": "37538214" },
  "words.items.scan-viewer": { "text": ["3D로 보는 Felipe", "돌리고 확대할 수 있는 170만 개 점의 스캔."], "from": "321c6afa" },
  "words.items.cluster-dashboard": { "text": ["클러스터 대시보드", "클러스터에서 무엇이, 어디서, 왜 고장 났는지."], "from": "1fba5b05" },
  "words.items.incident": { "text": ["멈춘 업그레이드 조사", "클러스터 데이터로 만든 타임라인, 영향받은 객체, 사후 분석."], "from": "bbeb1858" },
  "words.items.blast-radius": { "text": ["영향 범위", "ConfigMap, Secret, Service 또는 PVC를 고르고, 바꾸면 무엇이 깨지는지 보세요."], "from": "43eae8c0" },
  "words.items.runbook": { "text": ["멈춘 HelmRelease 런북", "클러스터를 읽는 점검, 실행할 명령, 그리고 공유 실행 기록."], "from": "764e548c" },
  "words.items.on-call-handover": { "text": ["당번 인수인계", "다음 사람을 위한 지난 12시간. 열린 항목을 하나씩 확인해요."], "from": "d83282cf" },
  "words.items.music-jam": { "text": ["뮤직 잼", "친구마다 트랙 하나씩, 모든 화면에서 같은 그루브가 흘러요."], "from": "5f3eb417" },
  "words.items.flat-tour": { "text": ["집 둘러보기", "하우스메이트들이 집의 3D 모델에 문제, 질문, 아이디어를 핀으로 꽂아요."], "from": "4feaf653" },
  "words.items.castillos": { "text": ["Castillos", "타일을 하나씩 놓아 왕국을 세우세요. AI와 또는 친구와 함께."], "from": "a1c329b2" },
  "words.items.kunobitos": { "text": ["Kunobitos", "앞을 보지 않고 걷는 꼬마 닌자들. 도장까지 가는 길은 당신이 정해요."], "from": "d590b43e" },
  "words.items.juego-de-la-oca": { "text": ["거위 게임", "고전 게임: 주사위를 굴리고 거위에서 거위로 뛰어 63번 칸에 먼저 도착하세요."], "from": "17bce2f7" },
  "words.items.pasalacabra": { "text": ["Pasalacabra", "글자 바퀴 두 개, 시계 두 개, 그리고 염소 한 마리. 누가 단어를 더 많이 알까요?"], "from": "32779b7f" }
}
