  "words.items.trip": { "text": ["Un weekend a Lisbona", "Due amici pianificano tre giorni su una mappa vera."], "from": "d6a47420" },
  "words.items.team": { "text": ["Sol Bakery", "La casa del team: questa settimana, decisioni e la wiki."], "from": "12ae36bc" },
  "words.items.expenses": { "text": ["Spese di casa condivise", "Affitto, bollette e spesa per quattro coinquilini, saldati in tre pagamenti."], "from": "6acf0c50" },
  "words.items.home-hunt": { "text": ["Cercare casa, insieme", "Due persone, i loro requisiti e le case che vanno bene a entrambi."], "from": "5292f10c" },
  "words.items.hiring": { "text": ["Assunzioni, fianco a fianco", "Dove i selezionatori non sono d'accordo, così il team ne può parlare."], "from": "1404fd08" },
  "words.items.birthday-film": { "text": ["Un film di compleanno", "30 secondi per un amico, con i vostri ricordi e una canzone originale."], "from": "c42c8b61" },
  "words.items.pitch-deck": { "text": ["Pitch seed", "Dieci slide che si costruiscono, si fermano e stanno su un telefono."], "from": "440f6ca4" },
  "words.items.event": { "text": ["Una festa per i 40 anni", "Una sala di quartiere, un piccolo budget e una disposizione dei tavoli che trova i problemi."], "from": "52617ff1" },
  "words.items.monthly-report": { "text": ["Report mensile", "Il mese di un piccolo negozio, spiegato dai suoi numeri."], "from": "567ea8f6" },
  "words.items.meals": { "text": ["Le cene di questa settimana", "Sette cene e la lista della spesa che ne viene fuori."], "from": "458ef47e" },
  "words.items.projects": { "text": ["Bacheca dell'apertura", "Un elenco di attività come bacheca, tabella e cronologia. Trascina una scheda per spostarla."], "from": "05ec06c6" },
  "words.items.dino-snack": { "text": ["Dino Snack", "Un gioco 3D per un bambino che ama i dinosauri."], "from": "44110def" },
  "words.items.content-calendar": { "text": ["Calendario dei contenuti", "Un mese di post di un caffè, dall'idea alla pubblicazione."], "from": "a78c5f5a" },
  "words.items.quiz-night": { "text": ["Quiz Night", "Le tue domande. Ogni squadra risponde dal proprio schermo e i punteggi vengono tenuti."], "from": "9939ffe2" },
  "words.items.cat-chase": { "text": ["Caccia al gatto", "Ognuno muove il proprio gatto per casa. Insegui i pesci, calcia il gomitolo."], "from": "cfd693d2" },
  "words.items.spectral-core": { "text": ["Luce, contenuta", "Vetro, luce e uno shader personalizzato."], "from": "178adebf" },
  "words.items.paper-explainer": { "text": ["Uno stencil, spiegato", "Carta, inchiostro e un ritaglio sollevato."], "from": "37538214" },
  "words.items.scan-viewer": { "text": ["Felipe, in 3D", "Una scansione da 1,7 milioni di punti che puoi ruotare e ingrandire."], "from": "321c6afa" },
  "words.items.cluster-dashboard": { "text": ["Dashboard del cluster", "Cosa non funziona nel tuo cluster, dove e perché."], "from": "1fba5b05" },
  "words.items.incident": { "text": ["Un upgrade bloccato, indagato", "Cronologia, oggetti coinvolti e un postmortem, costruiti dai dati del cluster."], "from": "bbeb1858" },
  "words.items.blast-radius": { "text": ["Raggio d'impatto", "Scegli un ConfigMap, Secret, Service o PVC e vedi cosa si rompe se lo cambi."], "from": "43eae8c0" },
  "words.items.runbook": { "text": ["Runbook per HelmRelease bloccate", "Controlli che leggono il cluster, i comandi da eseguire e un registro condiviso delle esecuzioni."], "from": "764e548c" },
  "words.items.on-call-handover": { "text": ["Passaggio di reperibilità", "Le ultime 12 ore per la persona successiva, che conferma ogni punto aperto."], "from": "d83282cf" },
  "words.items.music-jam": { "text": ["Music Jam", "Ogni amico ha la sua traccia, e ogni schermo suona lo stesso groove."], "from": "5f3eb417" },
  "words.items.flat-tour": { "text": ["Giro dell'appartamento", "I coinquilini segnano problemi, domande e idee su un modello 3D del loro appartamento."], "from": "4feaf653" }
