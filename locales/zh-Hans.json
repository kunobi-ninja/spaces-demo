  "words.items.trip": { "text": ["里斯本周末游", "两个朋友在真实地图上规划三天行程。"], "from": "d6a47420" },
  "words.items.team": { "text": ["Sol Bakery", "团队主页：本周安排、决定和 wiki。"], "from": "12ae36bc" },
  "words.items.expenses": { "text": ["合租开支", "四个室友的房租、账单和买菜钱，三笔付款就结清。"], "from": "6acf0c50" },
  "words.items.home-hunt": { "text": ["一起找房子", "两个人、各自的必备条件，以及两人都合适的房子。"], "from": "5292f10c" },
  "words.items.hiring": { "text": ["招聘，并排对比", "面试官在哪里有分歧，方便团队讨论。"], "from": "1404fd08" },
  "words.items.birthday-film": { "text": ["一部生日短片", "送给朋友的 30 秒，配上你们的回忆和一首原创歌曲。"], "from": "c42c8b61" },
  "words.items.pitch-deck": { "text": ["种子轮路演", "十页幻灯片，逐步展开、可以暂停，手机上也能看。"], "from": "440f6ca4" },
  "words.items.event": { "text": ["40 岁生日派对", "一个社区礼堂、一份小预算，还有能发现问题的座位安排。"], "from": "52617ff1" },
  "words.items.monthly-report": { "text": ["月度报告", "用数字讲清楚一家小店的一个月。"], "from": "567ea8f6" },
  "words.items.meals": { "text": ["本周晚餐", "七顿晚餐，以及由此汇总的购物清单。"], "from": "458ef47e" },
  "words.items.projects": { "text": ["开业看板", "同一份任务清单，可以看成看板、表格和时间线。拖动卡片就能移动。"], "from": "05ec06c6" },
  "words.items.dino-snack": { "text": ["Dino Snack", "给爱恐龙的小朋友的一款 3D 游戏。"], "from": "44110def" },
  "words.items.content-calendar": { "text": ["内容日历", "一家咖啡馆一个月的帖子，从点子到发布。"], "from": "a78c5f5a" },
  "words.items.quiz-night": { "text": ["Quiz Night", "你出题。每个队在自己的屏幕上答题，分数自动记录。"], "from": "9939ffe2" },
  "words.items.cat-chase": { "text": ["猫咪追逐", "每个人在房子里操控自己的猫。追鱼，踢毛线球。"], "from": "cfd693d2" },
  "words.items.spectral-core": { "text": ["光，被盛住", "玻璃、光，和一个自定义着色器。"], "from": "178adebf" },
  "words.items.paper-explainer": { "text": ["一张镂空模板的解说", "纸、墨水，和一块被掀起的镂空。"], "from": "37538214" },
  "words.items.scan-viewer": { "text": ["3D 版的 Felipe", "一个 170 万点的扫描，可以旋转和缩放。"], "from": "321c6afa" },
  "words.items.cluster-dashboard": { "text": ["集群仪表盘", "集群里哪里坏了、坏在哪、为什么坏。"], "from": "1fba5b05" },
  "words.items.incident": { "text": ["调查一次卡住的升级", "时间线、受影响的对象和复盘，全部基于集群数据。"], "from": "bbeb1858" },
  "words.items.blast-radius": { "text": ["影响范围", "选一个 ConfigMap、Secret、Service 或 PVC，看看改动它会弄坏什么。"], "from": "43eae8c0" },
  "words.items.runbook": { "text": ["卡住的 HelmRelease 运维手册", "读取集群的检查项、要运行的命令，以及共享的运行记录。"], "from": "764e548c" },
  "words.items.on-call-handover": { "text": ["值班交接", "把过去 12 小时交给下一位值班的人，由他逐项确认待办事项。"], "from": "d83282cf" },
  "words.items.music-jam": { "text": ["Music Jam", "每个朋友负责一条音轨，每块屏幕都播放同样的节奏。"], "from": "5f3eb417" },
  "words.items.flat-tour": { "text": ["看房之旅", "室友们在公寓的 3D 模型上标出问题、疑问和点子。"], "from": "4feaf653" }
