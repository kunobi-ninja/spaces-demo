  "words.items.juego-de-la-oca": { "text": ["ガチョウのゲーム", "定番のすごろく。サイコロを振り、ガチョウからガチョウへ跳んで、先に63マスへ。"], "from": "17bce2f7" },
  "words.items.pasalacabra": { "text": ["Pasalacabra", "文字の輪が2つ、時計が2つ、そしてヤギが1頭。ことばを多く知っているのはどっち？"], "from": "32779b7f" }
