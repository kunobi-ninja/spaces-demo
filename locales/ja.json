  "words.items.quiz-night": { "text": ["クイズナイト", "問題はあなたが作ります。各チームが自分の画面から答え、得点も記録されます。"], "from": "9939ffe2" },
  "words.items.cat-chase": { "text": ["ネコの追いかけっこ", "みんなが自分のネコを家の中で動かします。魚を追いかけて、毛糸玉を蹴とばそう。"], "from": "cfd693d2" },
  "words.items.spectral-core": { "text": ["閉じこめた光", "ガラスと光とカスタムシェーダー。"], "from": "178adebf" },
