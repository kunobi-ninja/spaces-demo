  "words.items.incident": { "text": ["止まったアップグレードの調査", "クラスターのデータから作ったタイムライン、影響を受けたオブジェクト、ポストモーテム。"], "from": "bbeb1858" },
  "words.items.blast-radius": { "text": ["影響範囲", "ConfigMap、Secret、Service、PVC を選ぶと、変更したら何が壊れるかがわかります。"], "from": "43eae8c0" },
  "words.items.runbook": { "text": ["止まった HelmRelease の手順書", "クラスターを読むチェック、実行するコマンド、共有の実行ログ。"], "from": "764e548c" },
  "words.items.on-call-handover": { "text": ["オンコールの引き継ぎ", "直近12時間を次の担当者へ。未解決の項目はひとつずつ確認してもらいます。"], "from": "d83282cf" },
  "words.items.music-jam": { "text": ["Music Jam", "友だちがそれぞれトラックを担当し、どの画面でも同じグルーヴが流れます。"], "from": "5f3eb417" },
  "words.items.flat-tour": { "text": ["部屋ツアー", "ルームメイトが部屋の3Dモデルに、問題・質問・アイデアのピンを立てます。"], "from": "4feaf653" },
  "words.items.castillos": { "text": ["Castillos", "タイルを置いて王国を築こう。AIとも、友だちとも。"], "from": "a1c329b2" },
