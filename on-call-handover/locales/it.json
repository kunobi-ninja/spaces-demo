  "words.prompts": { "text": ["“Scrivi il passaggio di stasera dagli eventi delle ultime 12 ore.”", "“Aggiungi un punto aperto per l'upgrade di pgo e assegnalo ad Ana.”", "“Chiudi ogni punto che nel cluster non è più in errore.”"], "from": "cfbdd4ed" },
  "data.handover.headline": { "text": "Workload in salute. 1 nuovo errore di Flux, 3 vecchi senza responsabile.", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["Nuovo 01:13: manca il path del chart di agent nella nuova revisione di apps. La vecchia release gira ancora; nessun rollout.", "Vecchi: l'upgrade di pgo blocca shop-* dal 25 ago · Alertmanager non ha ServiceAccount · il DNS di onechart fallisce.", "Riavvii: storage-api-0 una volta alle 17:30 (Error)."], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "il path del chart di agent non c'è più", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "La nuova revisione di apps (01:13 UTC) non ha apps/agent/deploy/helm/agent-memory, quindi la HelmRelease è SourceNotReady. La revisione 1293 del 9 nov continua a girare; nessun upgrade finché il path non corrisponde al repo.", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "Niente Alertmanager: manca il ServiceAccount", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster vuole 1 pod e ne ha 0. La creazione del pod è vietata: il ServiceAccount monitoring/vmalertmanager-cluster non esiste. Gli avvisi di vmalert non vengono consegnati.", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "Upgrade di pgo fallito, catena shop bloccata", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "L'upgrade Helm di shop/pgo (pgo@5.8.9) è andato in context deadline exceeded. shop-operators fallisce il suo health check su di esso; shop-databases e shop-apps lo aspettano.", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "Il repository onechart non si risolve", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "chart.onechart.dev restituisce no such host dal DNS del cluster. Rimuovi la HelmRepository se nessuno la usa.", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0 si è riavviato alle 17:30", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "Un riavvio nell'intervallo, motivo di uscita Error; 112 riavvii in totale. Aspetta di vederne un altro prima di intervenire.", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "12 pod node-shell rimasti", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "Pod di debug rimasti in kube-system. Tre escono e si riavviano in loop (circa 2.700 riavvii ciascuno). Si possono eliminare quando nessuno li usa.", "from": "bdbe16db" }
}
