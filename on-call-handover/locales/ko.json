  "words.prompts": { "text": ["“지난 12시간의 이벤트로 오늘 밤 인수인계를 써 줘.”", "“pgo 업그레이드에 대한 열린 항목을 추가하고 Ana에게 맡겨 줘.”", "“클러스터에서 더 이상 실패하지 않는 항목은 모두 닫아 줘.”"], "from": "cfbdd4ed" },
  "data.handover.headline": { "text": "워크로드는 정상. 새 Flux 실패 1건, 담당자 없는 예전 실패 3건.", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["새 실패 01:13: 새 apps 리비전에 agent 차트 경로가 없어요. 예전 릴리스는 계속 실행 중이고 롤아웃은 없어요.", "예전 실패: 8월 25일부터 pgo 업그레이드가 shop-*을 막고 있음 · Alertmanager에 ServiceAccount 없음 · onechart DNS 실패.", "재시작: storage-api-0이 17:30에 한 번 (Error)."], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "agent 차트 경로가 없어졌어요", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "새 apps 리비전(01:13 UTC)에 apps/agent/deploy/helm/agent-memory가 없어서 HelmRelease가 SourceNotReady예요. 11월 9일의 리비전 1293은 계속 실행돼요. 경로가 저장소와 맞을 때까지 업그레이드는 없어요.", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "Alertmanager 없음: ServiceAccount 누락", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster는 파드 1개가 필요한데 0개예요. 파드 생성이 금지됐어요: ServiceAccount monitoring/vmalertmanager-cluster가 없어요. vmalert의 알림이 전달되지 않아요.", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "pgo 업그레이드 실패, shop 체인 막힘", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "shop/pgo (pgo@5.8.9)의 Helm 업그레이드가 context deadline exceeded에 걸렸어요. shop-operators가 그 때문에 상태 검사에 실패하고, shop-databases와 shop-apps가 그걸 기다려요.", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "onechart 저장소 주소를 찾을 수 없어요", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "클러스터 DNS에서 chart.onechart.dev가 no such host를 돌려줘요. 아무도 안 쓰면 HelmRepository를 지우세요.", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0이 17:30에 재시작했어요", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "기간 내 재시작 1회, 종료 사유 Error. 누적 재시작 112회. 조치하기 전에 또 일어나는지 지켜보세요.", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "남아 있는 node-shell 파드 12개", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "kube-system에 남은 디버그 파드예요. 그중 셋은 종료와 재시작을 반복해요 (각각 약 2,700회). 아무도 안 쓰면 지워도 안전해요.", "from": "bdbe16db" }
}
