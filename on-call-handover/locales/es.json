  "words.prompts": { "text": ["“Escribe el relevo de esta noche a partir de los eventos de las últimas 12 horas.”", "“Añade un pendiente para el upgrade de pgo y asígnaselo a Ana.”", "“Cierra los pendientes que ya no fallan en el clúster.”"], "from": "cfbdd4ed" },
  "data.handover.headline": { "text": "Cargas sanas. 1 fallo nuevo en Flux y 3 antiguos sin responsable.", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["Nuevo 01:13: falta la ruta del chart de agent en la nueva revisión de apps. La release anterior sigue; no se despliega nada.", "Antiguos: el upgrade de pgo bloquea shop-* desde el 25 ago · Alertmanager sin ServiceAccount · onechart falla por DNS.", "Reinicios: storage-api-0 una vez a las 17:30 (Error)."], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "La ruta del chart de agent ya no existe", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "La nueva revisión de apps (01:13 UTC) no tiene apps/agent/deploy/helm/agent-memory, así que el HelmRelease está en SourceNotReady. La revisión 1293 del 9 nov sigue en marcha; no habrá upgrades hasta que la ruta coincida con el repo.", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "Sin Alertmanager: falta el ServiceAccount", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster quiere 1 pod y tiene 0. No se pueden crear pods: el ServiceAccount monitoring/vmalertmanager-cluster no existe. Las alertas de vmalert no se entregan.", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "Falló el upgrade de pgo, la cadena de shop está bloqueada", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "El upgrade de Helm de shop/pgo (pgo@5.8.9) acabó en context deadline exceeded. shop-operators falla su health check por eso; shop-databases y shop-apps esperan a que se resuelva.", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "El repositorio onechart no resuelve", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "chart.onechart.dev devuelve no such host desde el DNS del clúster. Elimina el HelmRepository si nadie lo usa.", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0 se reinició a las 17:30", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "Un reinicio en el periodo, motivo de salida Error; 112 reinicios en total. Espera a ver si hay otro antes de actuar.", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "12 pods node-shell olvidados", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "Pods de depuración que quedaron en kube-system. Tres de ellos terminan y se reinician en bucle (unos 2.700 reinicios cada uno). Se pueden borrar sin riesgo cuando nadie los use.", "from": "bdbe16db" }
