  "words.prompts": { "text": ["“根据过去 12 小时的事件写今晚的交接。”", "“为 pgo 升级添加一个待办事项，交给 Ana。”", "“关闭集群里所有已经不再出错的事项。”"], "from": "cfbdd4ed" },
  "data.handover.headline": { "text": "工作负载正常。1 个新的 Flux 故障，3 个旧故障没有负责人。", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["新 01:13：新的 apps 版本里缺少 agent chart 路径。旧 release 仍在运行；没有发布。", "旧：pgo 升级自 8 月 25 日起阻塞 shop-* · Alertmanager 没有 ServiceAccount · onechart DNS 解析失败。", "重启：storage-api-0 在 17:30 重启一次（Error）。"], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "agent chart 路径不见了", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "新的 apps 版本（01:13 UTC）里没有 apps/agent/deploy/helm/agent-memory，所以 HelmRelease 是 SourceNotReady。11 月 9 日的 1293 版本仍在运行；在路径与仓库一致之前不会升级。", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "没有 Alertmanager：缺少 ServiceAccount", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster 需要 1 个 Pod，实际是 0。Pod 创建被禁止：ServiceAccount monitoring/vmalertmanager-cluster 不存在。vmalert 的告警发不出去。", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "pgo 升级失败，shop 链路受阻", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "shop/pgo（pgo@5.8.9）的 Helm 升级遇到 context deadline exceeded。shop-operators 因此健康检查失败；shop-databases 和 shop-apps 在等它。", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "onechart 仓库无法解析", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "集群 DNS 对 chart.onechart.dev 返回 no such host。如果没有东西在用，就删除这个 HelmRepository。", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0 在 17:30 重启", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "时间范围内重启一次，退出原因 Error；累计重启 112 次。再出现一次再采取行动。", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "12 个残留的 node-shell Pod", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "留在 kube-system 里的调试 Pod。其中三个在循环退出又重启（每个约 2,700 次）。没人用了就可以安全删除。", "from": "bdbe16db" }
