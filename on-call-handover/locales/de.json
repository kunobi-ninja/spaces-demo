  "words.prompts": { "text": ["„Schreib die Übergabe für heute Abend aus den Events der letzten 12 Stunden.“", "„Füg einen offenen Punkt für das pgo-Upgrade hinzu und gib ihn Ana.“", "„Schließ jeden Punkt, der im Cluster nicht mehr fehlschlägt.“"], "from": "cfbdd4ed" },
  "data.handover.headline": { "text": "Workloads gesund. 1 neuer Flux-Fehler, 3 alte ohne Verantwortlichen.", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["Neu 01:13: Chart-Pfad von agent fehlt in der neuen apps-Revision. Das alte Release läuft weiter; keine Rollouts.", "Alt: pgo-Upgrade blockiert shop-* seit 25. Aug · Alertmanager hat keinen ServiceAccount · DNS für onechart schlägt fehl.", "Neustarts: storage-api-0 einmal um 17:30 (Error)."], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "Chart-Pfad von agent ist weg", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "Die neue apps-Revision (01:13 UTC) hat kein apps/agent/deploy/helm/agent-memory, daher ist das HelmRelease SourceNotReady. Revision 1293 vom 9. Nov läuft weiter; keine Upgrades, bis der Pfad zum Repo passt.", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "Kein Alertmanager: ServiceAccount fehlt", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster will 1 Pod und hat 0. Das Erstellen von Pods ist verboten: ServiceAccount monitoring/vmalertmanager-cluster existiert nicht. Alarme von vmalert werden nicht zugestellt.", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "pgo-Upgrade fehlgeschlagen, shop-Kette blockiert", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "Das Helm-Upgrade von shop/pgo (pgo@5.8.9) lief in context deadline exceeded. shop-operators scheitert daran am Health-Check; shop-databases und shop-apps warten darauf.", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "onechart-Repository wird nicht aufgelöst", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "chart.onechart.dev liefert im Cluster-DNS no such host. Entfern das HelmRepository, wenn nichts es nutzt.", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0 um 17:30 neu gestartet", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "Ein Neustart im Zeitraum, Exit-Grund Error; insgesamt 112 Neustarts. Warte auf einen weiteren, bevor du handelst.", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "12 übrig gebliebene node-shell-Pods", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "Debug-Pods, die in kube-system liegen geblieben sind. Drei davon beenden sich und starten in einer Schleife neu (je etwa 2,700 Neustarts). Können gelöscht werden, sobald niemand sie mehr nutzt.", "from": "bdbe16db" }
}
