  "data.handover.headline": { "text": "Workloads saudáveis. 1 falha nova no Flux, 3 antigas sem responsável.", "from": "9b25b2e9" },
  "data.handover.lines": { "text": ["Nova 01:13: falta o caminho do chart do agent na nova revisão de apps. O release antigo continua rodando; nenhum rollout.", "Antigas: upgrade do pgo bloqueia shop-* desde 25 ago · Alertmanager sem ServiceAccount · DNS do onechart falha.", "Reinícios: storage-api-0 uma vez às 17:30 (Error)."], "from": "0e1a67cc" },
  "data.items.items.agent-chart.title": { "text": "O caminho do chart do agent sumiu", "from": "88fdf4d5" },
  "data.items.items.agent-chart.detail": { "text": "A nova revisão de apps (01:13 UTC) não tem apps/agent/deploy/helm/agent-memory, então o HelmRelease está SourceNotReady. A revisão 1293 de 9 nov continua rodando; nenhum upgrade até o caminho bater com o repo.", "from": "97d598ed" },
  "data.items.items.vmalertmanager-sa.title": { "text": "Sem Alertmanager: falta o ServiceAccount", "from": "9d31ac88" },
  "data.items.items.vmalertmanager-sa.detail": { "text": "vmalertmanager-cluster quer 1 pod e tem 0. A criação de pods está proibida: o ServiceAccount monitoring/vmalertmanager-cluster não existe. Os alertas do vmalert não são entregues.", "from": "0da7e24b" },
  "data.items.items.pgo-upgrade.title": { "text": "Upgrade do pgo falhou, cadeia do shop bloqueada", "from": "d548bad2" },
  "data.items.items.pgo-upgrade.detail": { "text": "O upgrade do Helm de shop/pgo (pgo@5.8.9) deu context deadline exceeded. shop-operators falha no health check por causa dele; shop-databases e shop-apps esperam por isso.", "from": "85daeb0c" },
  "data.items.items.onechart-dns.title": { "text": "O repositório onechart não resolve", "from": "ef300961" },
  "data.items.items.onechart-dns.detail": { "text": "chart.onechart.dev retorna no such host no DNS do cluster. Remova o HelmRepository se nada usa ele.", "from": "1c7a10ad" },
  "data.items.items.storage-api-restart.title": { "text": "storage-api-0 reiniciou às 17:30", "from": "b5a43fcb" },
  "data.items.items.storage-api-restart.detail": { "text": "Um reinício no período, motivo de saída Error; 112 reinícios no total. Espere para ver se acontece outro antes de agir.", "from": "0c2c8e5f" },
  "data.items.items.node-shell-cleanup.title": { "text": "12 pods node-shell esquecidos", "from": "8a1cc777" },
  "data.items.items.node-shell-cleanup.detail": { "text": "Pods de depuração deixados em kube-system. Três deles saem e reiniciam em loop (cerca de 2.700 reinícios cada). Dá para excluir sem risco quando ninguém estiver usando.", "from": "bdbe16db" }
