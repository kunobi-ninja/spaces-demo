  "words.linea.eligeMesa": { "text": "테이블 고르기", "from": "25212f65" },
  "words.linea.eligeMesaAyuda": { "text": "모두 같은 테이블을 고르고 한 자리씩 앉으세요. 호스트는 Kunobi에서 게임을 시작하고, 게스트는 웹 링크로 플레이할 수 있어요.", "from": "7b03b024" },
  "words.linea.titulo": { "text": "온라인 플레이", "from": "4834b4a4" },
  "words.linea.jugadores": { "text": "명", "from": "5ca8223e" },
  "words.linea.recargar": { "text": "호스트는 Kunobi에서 테이블을 열어 둬요. 웹 링크를 새로 고쳤다면 같은 브라우저에서 같은 테이블을 다시 고르세요. 방이 열려 있는 동안 자리를 되찾을 수 있어요.", "from": "4aa572ef" },
  "words.linea.retomarAnfitrion": { "text": "방이 비면 호스트가 자기 기기에 저장된 게임을 이어서 할 수 있어요.", "from": "429a57ce" },
  "words.linea.barra": { "text": "온라인 · {{n}}인 테이블", "from": "0913e4b7" },
