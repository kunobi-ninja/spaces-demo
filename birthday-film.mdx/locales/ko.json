{
  "meta.title": { "text": "생일 영상", "from": "1dcf872e" },
  "meta.description": { "text": "이름, 나이, 추억 세 가지로 만드는 친구를 위한 30초 생일 영상이에요.", "from": "0cc5516f" },
  "words.turns": { "text": "{{age}}살이 돼요", "from": "a776e3e2" },
  "words.happy": { "text": "{{age}}살 축하해요, {{to}}", "from": "2f3db709" },
  "words.from": { "text": "{{name}} 보냄", "from": "a7386474" },
  "data.film.intro": { "text": "이 작은 영상을 바쳐요", "from": "9c39a1d9" },
  "data.film.memories[0].when": { "text": "2009년 여름", "from": "244d80c4" },
  "data.film.memories[0].title": { "text": "물에 잠긴 텐트", "from": "5d118c19" },
  "data.film.memories[0].line": { "text": "스카이섬에서 이틀 내내 비가 왔죠. 그래도 넌 최고의 여행이었다고 해.", "from": "51e6e951" },
  "data.film.memories[1].when": { "text": "2014년 봄", "from": "4e4e6d8c" },
  "data.film.memories[1].title": { "text": "자전거로 누빈 암스테르담", "from": "75e6b0c0" },
  "data.film.memories[1].line": { "text": "평지라고 약속했잖아. 우리 다리는 다르게 기억해.", "from": "fa12a0b0" },
  "data.film.memories[2].when": { "text": "그 후 매주 일요일", "from": "17a89a52" },
  "data.film.memories[2].title": { "text": "일요일 파스타 클럽", "from": "022e90d8" },
  "data.film.memories[2].line": { "text": "14년, 레시피 하나, 그리고 마늘을 둘러싼 똑같은 말다툼.", "from": "df434d95" },
  "data.film.wish": { "text": "소원을 빌어요", "from": "48338aa2" }
}
