{
  "meta.title": { "text": "Kunobitos", "from": "baaccad5" },
  "meta.description": { "text": "一款解谜游戏：一队 kunobito 从巢穴出来，不假思索地往前走；给它们技能，带它们穿过 28 个关卡抵达道场，星星和腰带都保存在这台设备上。", "from": "3065eac4" },
  "meta.prompts": { "text": ["在大师组添加第 29 关：一面水晶墙和一个水塘，给 2 个台阶和 3 个烟遁。", "在「水塘」这一关，给 5 个台阶而不是 3 个，并要求 10 个 kunobito 全部到达。"], "from": "c00c35ae" },
  "words.cerrar": { "text": "关闭", "from": "4bfd2cbe" },
  "words.titulo.gancho": { "text": "走路从不看路的小忍者。怎么把它们带到道场，由你决定。", "from": "4ee99aac" },
