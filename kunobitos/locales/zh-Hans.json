  "words.partida.visto": { "text": "被发现了！", "from": "9b7d5140" },
  "data.niveles.grupos[brotes].nombre": { "text": "新芽", "from": "4c7ab8bb" },
  "data.niveles.grupos[brotes].texto": { "text": "一次一个技能。", "from": "390d7436" },
  "data.niveles.grupos[raices].nombre": { "text": "根基", "from": "1da2d181" },
  "data.niveles.grupos[raices].texto": { "text": "新技能和第一次组合。", "from": "8a169df6" },
  "data.niveles.grupos[cumbres].nombre": { "text": "高峰", "from": "25099515" },
  "data.niveles.grupos[cumbres].texto": { "text": "同一关用上几种技能。", "from": "d9c06db9" },
  "data.niveles.grupos[bambu].nombre": { "text": "竹林", "from": "5b979ed0" },
  "data.niveles.grupos[bambu].texto": { "text": "在竹子间跳跃、甩钩绳。", "from": "11623b89" },
  "data.niveles.grupos[bambu].aviso": { "text": "踩到尖刺就会损失。只有隧道能穿过竹子。", "from": "8ea8dc72" },
  "data.niveles.grupos[tejados].nombre": { "text": "屋顶", "from": "a5466215" },
  "data.niveles.grupos[tejados].texto": { "text": "夜晚村庄里的潜行和烟遁。", "from": "2fe26fc4" },
  "data.niveles.grupos[tejados].aviso": { "text": "巡视灯笼看到没在潜行的 kunobito，就会把它送回巢穴。瓦片屋顶走不上去，纸墙一碰就整面倒下。", "from": "bad77d03" },
  "data.niveles.grupos[montana].nombre": { "text": "雪山", "from": "0b637a98" },
  "data.niveles.grupos[montana].texto": { "text": "雪峰上的风筝和苦无。", "from": "aa64582f" },
  "data.niveles.grupos[montana].aviso": { "text": "风会带着用风筝飞的 kunobito 走；瀑布会把正在飞或正在爬的冲下去。雪很好挖；冰挖不动，而且很滑。", "from": "a758f37a" },
  "data.niveles.grupos[maestro].nombre": { "text": "大师", "from": "db3d97ae" },
  "data.niveles.grupos[maestro].texto": { "text": "大师的考验：全部一起上。", "from": "ad390eaf" },
  "data.niveles.grupos[maestro].aviso": { "text": "只要有人踩着压板，对应的门就会开着。", "from": "c2ec6ab9" },
  "data.niveles.niveles[hacia-abajo].nombre": { "text": "往下走", "from": "028dc311" },
  "data.niveles.niveles[hacia-abajo].pista": { "text": "道场在地面下方。给一个 kunobito 竖井，其他的就会从洞里下去。", "from": "63d7ecc2" },
  "data.niveles.niveles[el-muro].nombre": { "text": "土墙", "from": "ba9a7bb3" },
  "data.niveles.niveles[el-muro].pista": { "text": "一堵土墙挡住了路。隧道会水平往前挖，就算提前一点给也没关系。", "from": "58cfee81" },
  "data.niveles.niveles[la-charca].nombre": { "text": "水塘", "from": "46f30ee6" },
  "data.niveles.niveles[la-charca].pista": { "text": "掉进水里就会损失。台阶能搭一座桥：在岸边前面给。", "from": "1a09d3d2" },
  "data.niveles.niveles[alto].nombre": { "text": "站住！", "from": "0387b0e5" },
  "data.niveles.niveles[alto].pista": { "text": "它们朝悬崖走去，而道场在身后。一个拦路就能让它们掉头。", "from": "ca4b7be1" },
  "data.niveles.niveles[paracaidas].nombre": { "text": "降落伞", "from": "835fb0b0" },
  "data.niveles.niveles[paracaidas].pista": { "text": "落差太高了。有了树叶，每个 kunobito 都能滑翔下去；在边缘前给。", "from": "ede525f0" },
  "data.niveles.niveles[escalada].nombre": { "text": "攀岩", "from": "7d84cd45" },
  "data.niveles.niveles[escalada].pista": { "text": "水晶既挖不动也打不破。用攀爬沿墙上去，再从另一边下来。", "from": "b91140db" },
  "data.niveles.niveles[bajo-la-roca].nombre": { "text": "岩石之下", "from": "791bb6f3" },
  "data.niveles.niveles[bajo-la-roca].pista": { "text": "水晶在脚的高度挡住了路。铁镐斜着往下挖，从下面穿过去；离墙远一点开始挖。", "from": "6497bff0" },
  "data.niveles.niveles[abre-paso].nombre": { "text": "开路", "from": "ab171cb0" },
  "data.niveles.niveles[abre-paso].pista": { "text": "没有隧道：给贴着墙的 kunobito 一个拦路，再给同一个 kunobito 一个火花。它一爆开，路就通了。", "from": "176d5fa1" },
  "data.niveles.niveles[doble-escalon].nombre": { "text": "双层台阶", "from": "d6224100" },
  "data.niveles.niveles[doble-escalon].pista": { "text": "道场在上方 24 像素处。一个台阶升高 12：铺完后再给同一个 kunobito 一个。", "from": "190d8cc7" },
  "data.niveles.niveles[bajo-el-cristal].nombre": { "text": "水晶之下", "from": "7225e9ef" },
  "data.niveles.niveles[bajo-el-cristal].pista": { "text": "上面是一面水晶墙，下面是一堵土墙。先往下，再穿过去。", "from": "23b5fba8" },
  "data.niveles.niveles[puente-y-bajada].nombre": { "text": "过桥下坡", "from": "983195f7" },
  "data.niveles.niveles[puente-y-bajada].pista": { "text": "先在水上搭一座桥。之后地面在悬崖处断了：铁镐能一点点安全地挖下去。", "from": "820fb531" },
  "data.niveles.niveles[el-largo-camino].nombre": { "text": "漫漫长路", "from": "1fd377a0" },
  "data.niveles.niveles[el-largo-camino].pista": { "text": "一堵墙、一个水塘、一片高台和一级水晶台阶。台阶要铺在每个障碍的正前方。", "from": "4387c1c0" },
  "data.niveles.niveles[pinchos].nombre": { "text": "尖刺", "from": "34a61f86" },
  "data.niveles.niveles[pinchos].pista": { "text": "踩到竹尖桩就会损失。跳跃能越过去：提前一点给。", "from": "5165870d" },
  "data.niveles.niveles[la-cana-alta].nombre": { "text": "高高的竹子", "from": "ddfde262" },
  "data.niveles.niveles[la-cana-alta].pista": { "text": "道场在上面，竹子顶上。钩绳把绳子甩到前上方的凸台上，吊着爬上去。", "from": "193b02eb" },
  "data.niveles.niveles[pasarela-rota].nombre": { "text": "断桥", "from": "192c42f8" },
  "data.niveles.niveles[pasarela-rota].pista": { "text": "先是尖刺，再是凸台：跳跃和钩绳，一个接一个。", "from": "7f76ada1" },
  "data.niveles.niveles[el-bosque-cerrado].nombre": { "text": "密林", "from": "ba95bdda" },
  "data.niveles.niveles[el-bosque-cerrado].pista": { "text": "只有隧道能穿过竹子。接着是尖刺和高台阶：每个人一个跳跃，大家共用一个台阶。", "from": "ac71825f" },
  "data.niveles.niveles[la-linterna].nombre": { "text": "灯笼", "from": "afac7c4c" },
  "data.niveles.niveles[la-linterna].pista": { "text": "潜行不够每人一个。不过灯笼也看不见紧跟在潜行者身后的那个：加快出发（+），隔一个给一个。", "from": "183c71b1" },
  "data.niveles.niveles[puerta-de-cristal].nombre": { "text": "水晶门", "from": "bb489fa3" },
  "data.niveles.niveles[puerta-de-cristal].pista": { "text": "水晶挖不动，但够薄的话烟遁能穿过去。纸墙则一碰就整面倒下。", "from": "055e96f8" },
  "data.niveles.niveles[muro-de-papel].nombre": { "text": "纸墙", "from": "ea510484" },
  "data.niveles.niveles[muro-de-papel].pista": { "text": "纸墙后有灯笼巡视，尽头还有一个走不上去的屋顶。隧道、两两潜行，再用跳跃上去。", "from": "84da47d5" },
  "data.niveles.niveles[ronda-de-noche].nombre": { "text": "夜巡", "from": "c1924084" },
  "data.niveles.niveles[ronda-de-noche].pista": { "text": "连着两盏灯笼，尽头是一面水晶墙。两两潜行如果给得早，能撑过两盏灯笼。", "from": "88d83a11" },
  "data.niveles.niveles[el-barranco].nombre": { "text": "峡谷", "from": "640e56cb" },
  "data.niveles.niveles[el-barranco].pista": { "text": "峡谷上方有风。有了风筝，跳进空中的 kunobito 能飞到对面。", "from": "024f1872" },
  "data.niveles.niveles[pared-helada].nombre": { "text": "冰墙", "from": "42aa3d58" },
  "data.niveles.niveles[pared-helada].pista": { "text": "冰挖不动，也很难爬。只要一个苦无，就能给大家留下一道梯子。", "from": "b49f0988" },
  "data.niveles.niveles[la-cascada].nombre": { "text": "瀑布", "from": "340f2d52" },
  "data.niveles.niveles[la-cascada].pista": { "text": "瀑布会把飞着的冲下去：风筝没用。下面的雪很好挖。", "from": "8365e722" },
  "data.niveles.niveles[la-cumbre].nombre": { "text": "山顶", "from": "2260ce0a" },
  "data.niveles.niveles[la-cumbre].pista": { "text": "高高的落差、有风的峡谷和一面冰墙。树叶用来下去，风筝用来飞越，苦无用来往上爬。", "from": "bd9f4885" },
  "data.niveles.niveles[la-placa].nombre": { "text": "压板", "from": "f9bcb498" },
  "data.niveles.niveles[la-placa].pista": { "text": "只要有人踩着坑里的压板，门就会开着。让一个掉下去，其他的跳过去；然后搭一座桥。最后用「结束」按钮收尾。", "from": "d33c30e6" },
  "data.niveles.niveles[prueba-del-humo].nombre": { "text": "烟之试炼", "from": "57650607" },
  "data.niveles.niveles[prueba-del-humo].pista": { "text": "一盏灯笼、一面水晶墙和一个凸台：两两潜行、烟遁和钩绳。", "from": "6955e5ae" },
  "data.niveles.niveles[prueba-del-viento].nombre": { "text": "风之试炼", "from": "c71628f8" },
  "data.niveles.niveles[prueba-del-viento].pista": { "text": "高台上的尖刺、有风的峡谷和一面冰墙：跳跃、风筝和苦无。", "from": "41518e85" },
  "data.niveles.niveles[el-camino-del-ninja].nombre": { "text": "忍者之道", "from": "7653554b" },
  "data.niveles.niveles[el-camino-del-ninja].pista": { "text": "学过的一切：纸墙、尖刺、灯笼、水晶、风和冰。早点结对。", "from": "048c8a04" }
}
