  "words.cintas.morada": { "text": "紫", "from": "d9327ac9" },
  "words.cintas.blanca": { "text": "白", "from": "a8f4eaa9" },
  "words.cintas.negra": { "text": "黑", "from": "27b24e7f" },
  "words.cinta.nombre": { "text": "{{nombre}}色腰带", "from": "2191c692" },
  "words.cinta.ganada": { "text": "{{nombre}}色腰带 ✓", "from": "81257026" },
  "words.cinta.ganadaTitulo": { "text": "{{nombre}}色腰带：已获得", "from": "bd513f35" },
  "words.cinta.alSuperar": { "text": "通过本组可得：{{nombre}}色腰带", "from": "71bbcfb3" },
  "words.habilidades.trepa.nombre": { "text": "攀爬", "from": "d2e292f5" },
  "words.habilidades.trepa.queHace": { "text": "沿着墙往上爬。可以和其他技能叠加，也能在空中给。", "from": "866d6a78" },
  "words.habilidades.hoja.nombre": { "text": "树叶", "from": "7e679173" },
  "words.habilidades.hoja.queHace": { "text": "滑翔下落，从任何高度都能安全着地。也能在空中给。", "from": "fd2f5ffb" },
  "words.habilidades.planton.nombre": { "text": "拦路", "from": "96e3929b" },
  "words.habilidades.planton.queHace": { "text": "张开双臂站着不动：其他 kunobito 撞到它就会掉头。", "from": "a831125c" },
  "words.habilidades.chispa.nombre": { "text": "火花", "from": "960468d8" },
  "words.habilidades.chispa.queHace": { "text": "倒数 5 秒后爆开，在泥土上炸出一个洞（水晶不行）。它自己会损失掉。", "from": "f4eb9e53" },
  "words.habilidades.peldano.nombre": { "text": "台阶", "from": "3246b11a" },
  "words.habilidades.peldano.queHace": { "text": "斜向上铺 12 块木板。在要越过的东西前面给。", "from": "0e84f0c7" },
  "words.habilidades.tunel.nombre": { "text": "隧道", "from": "7dd3e84d" },
  "words.habilidades.tunel.queHace": { "text": "水平往前挖，直到挖出泥土。提前一点给也行，它会先走过去。", "from": "28016041" },
  "words.habilidades.pico.nombre": { "text": "铁镐", "from": "d73f246b" },
  "words.habilidades.pico.queHace": { "text": "斜向下挖出一条坡道，可以安全地走下去。", "from": "761b606d" },
  "words.habilidades.pozo.nombre": { "text": "竖井", "from": "102c81dc" },
  "words.habilidades.pozo.queHace": { "text": "一直往下挖，直到挖穿地面。", "from": "f00c1337" },
  "words.habilidades.gancho.nombre": { "text": "钩绳", "from": "2ca834c4" },
  "words.habilidades.gancho.queHace": { "text": "把绳子甩到前上方的凸台上，吊着爬上去再翻过去。没有能钩住的地方就不会消耗。", "from": "261435c2" },
  "words.habilidades.salto.nombre": { "text": "跳跃", "from": "95862a91" },
  "words.habilidades.salto.queHace": { "text": "划出一道弧线跳过尖刺、小水塘和缺口，稳稳落地。", "from": "6a5f0922" },
  "words.habilidades.humo.nombre": { "text": "烟遁", "from": "7eca259a" },
  "words.habilidades.humo.queHace": { "text": "化作一团烟消失，从薄墙（水晶墙也行）的另一边出来。在靠近墙的地方给。", "from": "f029d3d0" },
  "words.habilidades.kunai.nombre": { "text": "苦无", "from": "2098c4c8" },
  "words.habilidades.kunai.queHace": { "text": "在前方墙上钉入四支苦无：它和后面来的都能踩着爬上去。", "from": "7155981c" },
  "words.habilidades.sigilo.nombre": { "text": "潜行", "from": "219b28a8" },
  "words.habilidades.sigilo.queHace": { "text": "蹲低前进约 10 秒：巡视灯笼看不见它，也看不见紧跟在它身后的那个。", "from": "d9cafd13" },
  "words.habilidades.cometa.nombre": { "text": "风筝", "from": "5a5acae0" },
  "words.habilidades.cometa.queHace": { "text": "有风时水平飞行，没风时滑翔。在边缘前或空中给。", "from": "1779a336" },
  "words.partida.ayuda": { "text": "帮助", "from": "936567a8" },
  "words.partida.ayudaTecla": { "text": "帮助 (?)", "from": "81d9053b" },
  "words.partida.comoSeJuega": { "text": "怎么玩", "from": "4514694a" },
  "words.partida.objetivoGeneral": { "text": "kunobito 从巢穴出来后会自己往前走。在下方选一个技能，点一下 kunobito 就能给它。在时间用完前，至少把关卡要求的数量带到道场。", "from": "d9c56c53" },
  "words.partida.controles": { "text": "**操作：** 点 kunobito 给它技能 · 拖动移动视角 · 滚轮、双指捏合或 + / − 缩放 · 点小地图跳转。**按键：** 1–{{n}} 技能，P 暂停，F ×2，+ / − 节奏，M 声音，? 帮助。", "from": "4a1bec2c" },
  "words.partida.peligros": { "text": "从太高的地方掉下来会摔晕，掉进水里或走出地图就会损失。水晶既挖不动也打不破。", "from": "fea6c8d5" },
  "words.partida.estrellasRegla": { "text": "**星星：** 到达道场的数量达到要求得 ★，最多损失两个得 ★★，全部到达得 ★★★。", "from": "1e864df3" },
  "words.partida.entendido": { "text": "明白了", "from": "366f6095" },
