  "words.titulo.escena": { "text": "{{grupo}} · {{nivel}}", "from": "741e4bfc" },
  "words.ayuda.titulo": { "text": "怎么玩", "from": "4514694a" },
  "words.ayuda.paso1": { "text": "kunobito 从巢穴出来后会自己往前走，不看路。", "from": "7a7264fc" },
  "words.ayuda.paso2": { "text": "选一个技能，点一下 kunobito 就能给它。", "from": "112c8a4f" },
  "words.ayuda.paso3": { "text": "在时间用完前，把关卡要求的数量带到道场。", "from": "3122cfed" },
  "words.ayuda.una": { "text": "到达数达到关卡要求", "from": "fa595648" },
  "words.ayuda.dos": { "text": "最多损失两个", "from": "899ab646" },
  "words.ayuda.tres": { "text": "全部到达", "from": "27bfedf2" },
  "words.ayuda.controles": { "text": "**操作：** 拖动移动视角；滚轮、双指捏合或 + 和 − 缩放。按键：**1–8** 技能，**P** 暂停，**F** ×2，**+** 和 **−** 出发节奏，**M** 声音。", "from": "1112af29" },
  "words.ayuda.entendido": { "text": "明白了！", "from": "4fa5ec2c" },
