  "data.niveles.grupos[cumbres].nombre": { "text": "봉우리", "from": "25099515" },
  "data.niveles.grupos[cumbres].texto": { "text": "한 레벨에 여러 능력.", "from": "d9c06db9" },
  "data.niveles.grupos[bambu].nombre": { "text": "대나무", "from": "5b979ed0" },
  "data.niveles.grupos[bambu].texto": { "text": "대나무 사이에서 점프와 갈고리.", "from": "11623b89" },
  "data.niveles.grupos[bambu].aviso": { "text": "가시를 밟으면 잃게 돼요. 대나무는 터널로만 뚫을 수 있어요.", "from": "8ea8dc72" },
  "data.niveles.grupos[tejados].nombre": { "text": "지붕", "from": "a5466215" },
  "data.niveles.grupos[tejados].texto": { "text": "밤의 마을에서 은신과 연막.", "from": "2fe26fc4" },
  "data.niveles.grupos[tejados].aviso": { "text": "감시 등불은 은신 없이 보이는 kunobito를 둥지로 돌려보내요. 기와지붕은 걸어서 오를 수 없고, 종이는 한 번 치면 통째로 쓰러져요.", "from": "bad77d03" },
  "data.niveles.grupos[montana].nombre": { "text": "산", "from": "0b637a98" },
  "data.niveles.grupos[montana].texto": { "text": "눈 덮인 정상에서 연과 쿠나이.", "from": "aa64582f" },
  "data.niveles.grupos[montana].aviso": { "text": "연으로 나는 kunobito는 바람에 실려 가요. 폭포는 날거나 벽을 타는 kunobito를 떨어뜨려요. 눈은 빨리 파이지만 얼음은 파이지 않고 미끄러워요.", "from": "a758f37a" },
  "data.niveles.grupos[maestro].nombre": { "text": "마스터", "from": "db3d97ae" },
  "data.niveles.grupos[maestro].texto": { "text": "스승의 시험: 모든 걸 함께.", "from": "ad390eaf" },
  "data.niveles.grupos[maestro].aviso": { "text": "누군가 발판을 밟고 있는 동안 그 문은 열려 있어요.", "from": "c2ec6ab9" },
  "data.niveles.niveles[hacia-abajo].nombre": { "text": "아래로", "from": "028dc311" },
  "data.niveles.niveles[hacia-abajo].pista": { "text": "도장은 바닥 아래에 있어요. 한 kunobito에게 구덩이를 주면 나머지는 그 구멍으로 내려가요.", "from": "63d7ecc2" },
  "data.niveles.niveles[el-muro].nombre": { "text": "벽", "from": "ba9a7bb3" },
  "data.niveles.niveles[el-muro].pista": { "text": "흙벽이 길을 막아요. 터널은 조금 일찍 줘도 옆으로 파 나가요.", "from": "58cfee81" },
  "data.niveles.niveles[la-charca].nombre": { "text": "웅덩이", "from": "46f30ee6" },
  "data.niveles.niveles[la-charca].pista": { "text": "물에 빠지면 잃게 돼요. 계단으로 다리를 놓아요. 물가 바로 앞에서 주세요.", "from": "1a09d3d2" },
  "data.niveles.niveles[alto].nombre": { "text": "멈춰!", "from": "0387b0e5" },
  "data.niveles.niveles[alto].pista": { "text": "모두 절벽 쪽으로 가는데 도장은 뒤에 있어요. 막기로 방향을 돌리세요.", "from": "ca4b7be1" },
  "data.niveles.niveles[paracaidas].nombre": { "text": "낙하산", "from": "835fb0b0" },
  "data.niveles.niveles[paracaidas].pista": { "text": "너무 높아요. 나뭇잎이 있으면 각자 활공해서 내려가요. 가장자리 전에 주세요.", "from": "ede525f0" },
  "data.niveles.niveles[escalada].nombre": { "text": "등반", "from": "7d84cd45" },
  "data.niveles.niveles[escalada].pista": { "text": "크리스털은 파거나 부술 수 없어요. 벽타기로 벽을 올라 반대편으로 내려가요.", "from": "b91140db" },
  "data.niveles.niveles[bajo-la-roca].nombre": { "text": "바위 아래", "from": "791bb6f3" },
  "data.niveles.niveles[bajo-la-roca].pista": { "text": "발 높이에서 크리스털이 길을 막아요. 곡괭이는 대각선으로 파서 그 아래를 지나가요. 벽에서 멀리서 시작하세요.", "from": "6497bff0" },
  "data.niveles.niveles[abre-paso].nombre": { "text": "길을 열어라", "from": "ab171cb0" },
  "data.niveles.niveles[abre-paso].pista": { "text": "터널은 없어요. 벽에 붙은 kunobito에게 막기를, 그 kunobito에게 다시 불꽃을. 터지면 길이 열려요.", "from": "176d5fa1" },
  "data.niveles.niveles[doble-escalon].nombre": { "text": "두 단 오르기", "from": "d6224100" },
  "data.niveles.niveles[doble-escalon].pista": { "text": "도장은 24픽셀 위에 있어요. 계단 하나로 12만큼 올라가니, 끝나면 같은 kunobito에게 하나 더 주세요.", "from": "190d8cc7" },
  "data.niveles.niveles[bajo-el-cristal].nombre": { "text": "크리스털 아래", "from": "7225e9ef" },
  "data.niveles.niveles[bajo-el-cristal].pista": { "text": "위에는 크리스털 벽, 아래에는 흙벽. 먼저 내려간 다음 뚫고 지나가야 해요.", "from": "23b5fba8" },
  "data.niveles.niveles[puente-y-bajada].nombre": { "text": "다리와 내리막", "from": "983195f7" },
  "data.niveles.niveles[puente-y-bajada].pista": { "text": "먼저 물 위에 다리를 놓아요. 그다음 땅이 절벽에서 끝나요. 곡괭이로 조금씩 안전하게 내려가요.", "from": "820fb531" },
  "data.niveles.niveles[el-largo-camino].nombre": { "text": "머나먼 길", "from": "1fd377a0" },
  "data.niveles.niveles[el-largo-camino].pista": { "text": "벽, 웅덩이, 고원, 크리스털 턱. 계단은 넘어야 할 것 바로 앞에 놓으세요.", "from": "4387c1c0" },
  "data.niveles.niveles[pinchos].nombre": { "text": "가시", "from": "34a61f86" },
  "data.niveles.niveles[pinchos].pista": { "text": "대나무 가시를 밟으면 잃게 돼요. 점프로 넘을 수 있어요. 조금 일찍 주세요.", "from": "5165870d" },
  "data.niveles.niveles[la-cana-alta].nombre": { "text": "높은 대나무", "from": "ddfde262" },
  "data.niveles.niveles[la-cana-alta].pista": { "text": "도장은 대나무 위에 있어요. 갈고리는 앞쪽 위의 턱에 밧줄을 던져 매달려 올라가요.", "from": "193b02eb" },
  "data.niveles.niveles[pasarela-rota].nombre": { "text": "부서진 다리", "from": "192c42f8" },
  "data.niveles.niveles[pasarela-rota].pista": { "text": "먼저 가시, 그다음 턱. 점프와 갈고리를 차례로.", "from": "7f76ada1" },
  "data.niveles.niveles[el-bosque-cerrado].nombre": { "text": "빽빽한 숲", "from": "ba95bdda" },
  "data.niveles.niveles[el-bosque-cerrado].pista": { "text": "대나무는 터널로만 뚫려요. 그다음 가시와 높은 턱. 점프는 한 명씩, 계단은 모두를 위해 하나.", "from": "ac71825f" },
  "data.niveles.niveles[la-linterna].nombre": { "text": "등불", "from": "afac7c4c" },
  "data.niveles.niveles[la-linterna].pista": { "text": "은신은 모두에게 줄 만큼 없어요. 하지만 은신한 kunobito 바로 뒤에 붙은 kunobito도 보이지 않아요. 출발을 빠르게(+) 하고 한 명 걸러 한 명씩 주세요.", "from": "183c71b1" },
  "data.niveles.niveles[puerta-de-cristal].nombre": { "text": "크리스털 문", "from": "bb489fa3" },
  "data.niveles.niveles[puerta-de-cristal].pista": { "text": "크리스털은 파이지 않지만 얇으면 연막으로 통과할 수 있어요. 반면 종이는 한 번 치면 통째로 쓰러져요.", "from": "055e96f8" },
  "data.niveles.niveles[muro-de-papel].nombre": { "text": "종이 벽", "from": "ea510484" },
  "data.niveles.niveles[muro-de-papel].pista": { "text": "종이 뒤에서 등불이 지키고, 끝에는 걸어서 오를 수 없는 지붕이 있어요. 터널, 둘씩 짝지은 은신, 그리고 오르기 위한 점프.", "from": "84da47d5" },
  "data.niveles.niveles[ronda-de-noche].nombre": { "text": "야간 순찰", "from": "c1924084" },
  "data.niveles.niveles[ronda-de-noche].pista": { "text": "등불 두 개가 연달아 있고 끝에는 크리스털 벽. 둘씩 짝지은 은신을 일찍 주면 둘 다 버틸 수 있어요.", "from": "88d83a11" },
  "data.niveles.niveles[el-barranco].nombre": { "text": "협곡", "from": "640e56cb" },
  "data.niveles.niveles[el-barranco].pista": { "text": "협곡 위로 바람이 불어요. 연이 있으면 허공으로 뛰어든 kunobito가 건너편까지 날아가요.", "from": "024f1872" },
  "data.niveles.niveles[pared-helada].nombre": { "text": "얼어붙은 벽", "from": "42aa3d58" },
  "data.niveles.niveles[pared-helada].pista": { "text": "얼음은 파이지 않고 오르기도 어려워요. 쿠나이 하나면 모두를 위한 사다리가 생겨요.", "from": "b49f0988" },
  "data.niveles.niveles[la-cascada].nombre": { "text": "폭포", "from": "340f2d52" },
  "data.niveles.niveles[la-cascada].pista": { "text": "폭포는 나는 kunobito를 떨어뜨려요. 연은 소용없어요. 아래쪽 눈은 빨리 파여요.", "from": "8365e722" },
  "data.niveles.niveles[la-cumbre].nombre": { "text": "정상", "from": "2260ce0a" },
  "data.niveles.niveles[la-cumbre].pista": { "text": "높은 낙차, 바람 부는 협곡, 얼음벽. 내려갈 땐 나뭇잎, 건널 땐 연, 오를 땐 쿠나이.", "from": "bd9f4885" },
  "data.niveles.niveles[la-placa].nombre": { "text": "발판", "from": "f9bcb498" },
  "data.niveles.niveles[la-placa].pista": { "text": "누군가 구덩이의 발판을 밟고 있는 동안 문은 열려 있어요. 한 명을 떨어뜨리고 나머지는 점프, 그다음 다리를 놓으세요. 마지막엔 끝내기 버튼으로 마무리해요.", "from": "d33c30e6" },
  "data.niveles.niveles[prueba-del-humo].nombre": { "text": "연기의 시험", "from": "57650607" },
  "data.niveles.niveles[prueba-del-humo].pista": { "text": "등불, 크리스털 벽, 턱. 둘씩 짝지은 은신, 연막, 갈고리.", "from": "6955e5ae" },
  "data.niveles.niveles[prueba-del-viento].nombre": { "text": "바람의 시험", "from": "c71628f8" },
  "data.niveles.niveles[prueba-del-viento].pista": { "text": "고원 위의 가시, 바람 부는 협곡, 얼음벽. 점프, 연, 쿠나이.", "from": "41518e85" },
  "data.niveles.niveles[el-camino-del-ninja].nombre": { "text": "닌자의 길", "from": "7653554b" },
  "data.niveles.niveles[el-camino-del-ninja].pista": { "text": "지금까지 배운 모든 것: 종이, 가시, 등불, 크리스털, 바람, 얼음. 일찍 짝을 지으세요.", "from": "048c8a04" }
}
