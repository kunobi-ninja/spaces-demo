  "words.ayuda.titulo": { "text": "게임 방법", "from": "4514694a" },
  "words.ayuda.paso1": { "text": "kunobito들은 둥지에서 나와 앞을 보지 않고 혼자 걸어요.", "from": "7a7264fc" },
  "words.ayuda.paso2": { "text": "능력을 고르고 kunobito를 탭해서 주세요.", "from": "112c8a4f" },
  "words.ayuda.paso3": { "text": "시간이 끝나기 전에 레벨이 요구하는 수만큼 도장으로 데려가세요.", "from": "3122cfed" },
  "words.ayuda.una": { "text": "요구한 수만큼 도착", "from": "fa595648" },
  "words.ayuda.dos": { "text": "잃는 건 최대 2명", "from": "899ab646" },
  "words.ayuda.tres": { "text": "모두 도착", "from": "27bfedf2" },
  "words.ayuda.controles": { "text": "**조작:** 드래그로 화면 이동, 휠·핀치·+ 와 − 로 확대/축소. 키: **1–8** 능력, **P** 일시정지, **F** ×2, **+** 와 **−** 출발 간격, **M** 소리.", "from": "1112af29" },
  "words.ayuda.entendido": { "text": "알겠어요!", "from": "4fa5ec2c" },
