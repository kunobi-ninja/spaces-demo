  "words.turnos.titulo": { "text": "번갈아 하기", "from": "8da3cc7c" },
  "words.turnos.explica": { "text": "이 기기에서 같은 레벨을 한 명씩 차례로 플레이해요. 도장에 kunobito를 더 많이 데려간 사람이 이겨요.", "from": "28ecac7d" },
