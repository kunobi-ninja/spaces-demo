  "data.quiz.rounds[0].questions[0].fact": { "text": "堪培拉是作为悉尼和墨尔本之间的折中方案而建的。议会在 1927 年迁到那里。", "from": "87c617c7" },
  "data.quiz.rounds[0].questions[1].q": { "text": "哪个国家的天然湖泊最多？", "from": "a20f9baf" },
  "data.quiz.rounds[0].questions[1].options": { "text": ["俄罗斯", "加拿大", "芬兰", "美国"], "from": "4e3f1b91" },
  "data.quiz.rounds[0].questions[1].fact": { "text": "加拿大拥有世界上大约 60% 的天然湖泊。", "from": "7205e592" },
  "data.quiz.rounds[0].questions[2].q": { "text": "阿塔卡马沙漠是地球上最干旱的沙漠之一，它大部分位于哪个国家？", "from": "ede707d3" },
  "data.quiz.rounds[0].questions[2].options": { "text": ["秘鲁", "墨西哥", "埃及", "智利"], "from": "ac6c82da" },
  "data.quiz.rounds[0].questions[2].fact": { "text": "阿塔卡马的一些气象站从未记录到降雨。", "from": "4b5ed677" },
  "data.quiz.rounds[0].questions[3].q": { "text": "算上海外领土，法国一共使用多少个时区？", "from": "440447ea" },
  "data.quiz.rounds[0].questions[3].options": { "text": ["1", "3", "12", "24"], "from": "7d223d0a" },
  "data.quiz.rounds[0].questions[3].fact": { "text": "从法属波利尼西亚到新喀里多尼亚，法国横跨 12 个时区，比其他任何国家都多。", "from": "1aec9940" },
  "data.quiz.rounds[1].theme": { "text": "美食与饮品", "from": "0786f78e" },
  "data.quiz.rounds[1].questions[0].q": { "text": "杏仁糖膏的主要原料是哪种坚果？", "from": "4d77736f" },
  "data.quiz.rounds[1].questions[0].options": { "text": ["杏仁", "榛子", "腰果", "开心果"], "from": "56ca9c6c" },
  "data.quiz.rounds[1].questions[0].fact": { "text": "杏仁糖膏就是杏仁粉加糖。德国的吕贝克和西班牙的托莱多都说它源自自己。", "from": "7aea1629" },
  "data.quiz.rounds[1].questions[1].q": { "text": "哪个国家种植的咖啡最多？", "from": "e8f70600" },
  "data.quiz.rounds[1].questions[1].options": { "text": ["哥伦比亚", "越南", "巴西", "埃塞俄比亚"], "from": "9d51baba" },
  "data.quiz.rounds[1].questions[1].fact": { "text": "巴西种植了世界上约三分之一的咖啡。", "from": "e39c42f0" },
  "data.quiz.rounds[1].questions[2].q": { "text": "藏红花来自植物的哪个部位？", "from": "a4527a58" },
  "data.quiz.rounds[1].questions[2].options": { "text": ["种子", "花的柱头", "树皮", "根"], "from": "4d1cd5bb" },
  "data.quiz.rounds[1].questions[2].fact": { "text": "每朵番红花有三根柱头，全靠手工采摘。一公斤大约需要 15 万朵花。", "from": "b89fcd89" },
  "data.quiz.rounds[1].questions[3].q": { "text": "下面哪一个不是意大利面？", "from": "967191f1" },
