  "data.quiz.rounds[2].questions[1].q": { "text": "阳光到达地球需要多长时间？", "from": "746e1acb" },
  "data.quiz.rounds[2].questions[1].options": { "text": ["约 8 秒", "约 8 分钟", "约 8 小时", "约一天"], "from": "7b70665f" },
  "data.quiz.rounds[2].questions[1].fact": { "text": "阳光要走大约 8 分 20 秒，所以你看到的总是太阳过去的样子。", "from": "7b21b831" },
  "data.quiz.rounds[2].questions[2].q": { "text": "哪种动物有三颗心脏？", "from": "30a233eb" },
  "data.quiz.rounds[2].questions[2].options": { "text": ["章鱼", "鲨鱼", "青蛙", "海星"], "from": "d61ee5a7" },
  "data.quiz.rounds[2].questions[2].fact": { "text": "两颗心脏把血液泵过鳃；第三颗把血液泵向全身。", "from": "118cd81c" },
  "data.quiz.rounds[2].questions[3].q": { "text": "金的化学符号是什么？", "from": "06fa9b6f" },
  "data.quiz.rounds[2].questions[3].options": { "text": ["Go", "Gd", "Ag", "Au"], "from": "c2c1255f" },
  "data.quiz.rounds[2].questions[3].fact": { "text": "Au 来自拉丁语里表示金的 aurum。Ag 来自 argentum，是银。", "from": "71738f6b" },
  "data.quiz.rounds[3].theme": { "text": "音乐与电影", "from": "b72b3462" },
  "data.quiz.rounds[3].questions[0].q": { "text": "一架标准钢琴有多少个琴键？", "from": "5283df33" },
  "data.quiz.rounds[3].questions[0].options": { "text": ["76", "88", "92", "100"], "from": "e2b7aa7e" },
  "data.quiz.rounds[3].questions[0].fact": { "text": "52 个白键和 36 个黑键，跨越七个多八度。", "from": "4bd09ce0" },
  "data.quiz.rounds[3].questions[1].q": { "text": "哪个乐队发行了专辑 Abbey Road？", "from": "ccee2885" },
  "data.quiz.rounds[3].questions[1].options": { "text": ["The Rolling Stones", "Queen", "The Beatles", "Pink Floyd"], "from": "3847ad00" },
  "data.quiz.rounds[3].questions[1].fact": { "text": "专辑以乐队录音所在的伦敦街道命名，于 1969 年发行。", "from": "657f8d2f" },
  "data.quiz.rounds[3].questions[2].q": { "text": "哪部电影获得了第一届奥斯卡最佳影片奖？", "from": "d80765cd" },
  "data.quiz.rounds[3].questions[2].options": { "text": ["《翼》", "《卡萨布兰卡》", "《大都会》", "《乱世佳人》"], "from": "d037ac36" },
  "data.quiz.rounds[3].questions[2].fact": { "text": "《翼》是一部关于一战飞行员的默片，在 1929 年的第一届颁奖礼上获奖。", "from": "2f3a268a" },
  "data.quiz.rounds[3].questions[3].q": { "text": "在乐谱里，forte 是让你怎么做？", "from": "3687b999" },
  "data.quiz.rounds[3].questions[3].options": { "text": ["弹慢一点", "弹轻一点", "弹响一点", "重复这一小节"], "from": "59d82c26" },
  "data.quiz.rounds[3].questions[3].fact": { "text": "forte 在意大利语里是“强”的意思。它的反义词 piano 成了钢琴的名字。", "from": "75e1beb2" }
