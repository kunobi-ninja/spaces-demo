  "data.quiz.rounds[0].theme": { "text": "세계 일주", "from": "9eb7a570" },
  "data.quiz.rounds[0].questions[0].q": { "text": "오스트레일리아의 수도는 어디일까요?", "from": "63e0040f" },
  "data.quiz.rounds[0].questions[0].options": { "text": ["시드니", "멜버른", "캔버라", "퍼스"], "from": "5e9ce7ac" },
  "data.quiz.rounds[0].questions[0].fact": { "text": "캔버라는 시드니와 멜버른 사이의 타협안으로 세워졌어요. 의회는 1927년에 그곳으로 옮겼어요.", "from": "87c617c7" },
  "data.quiz.rounds[0].questions[1].q": { "text": "자연 호수가 가장 많은 나라는?", "from": "a20f9baf" },
  "data.quiz.rounds[0].questions[1].options": { "text": ["러시아", "캐나다", "핀란드", "미국"], "from": "4e3f1b91" },
  "data.quiz.rounds[0].questions[1].fact": { "text": "캐나다에는 세계 자연 호수의 약 60%가 있어요.", "from": "7205e592" },
  "data.quiz.rounds[0].questions[2].q": { "text": "지구에서 가장 건조한 사막 중 하나인 아타카마는 주로 어느 나라에 있을까요?", "from": "ede707d3" },
  "data.quiz.rounds[0].questions[2].options": { "text": ["페루", "멕시코", "이집트", "칠레"], "from": "ac6c82da" },
  "data.quiz.rounds[0].questions[2].fact": { "text": "아타카마의 어떤 기상 관측소는 비를 한 번도 기록한 적이 없어요.", "from": "4b5ed677" },
  "data.quiz.rounds[0].questions[3].q": { "text": "해외 영토까지 세면 프랑스는 시간대를 몇 개 쓸까요?", "from": "440447ea" },
  "data.quiz.rounds[0].questions[3].options": { "text": ["1", "3", "12", "24"], "from": "7d223d0a" },
  "data.quiz.rounds[0].questions[3].fact": { "text": "프랑스령 폴리네시아부터 뉴칼레도니아까지, 프랑스는 12개 시간대에 걸쳐 있어요. 어느 나라보다 많아요.", "from": "1aec9940" },
  "data.quiz.rounds[1].theme": { "text": "음식과 음료", "from": "0786f78e" },
  "data.quiz.rounds[1].questions[0].q": { "text": "마지판의 주재료인 견과류는?", "from": "4d77736f" },
  "data.quiz.rounds[1].questions[0].options": { "text": ["아몬드", "헤이즐넛", "캐슈너트", "피스타치오"], "from": "56ca9c6c" },
  "data.quiz.rounds[1].questions[0].fact": { "text": "마지판은 간 아몬드와 설탕으로 만들어요. 독일의 뤼베크와 스페인의 톨레도가 서로 원조라고 해요.", "from": "7aea1629" },
  "data.quiz.rounds[1].questions[1].q": { "text": "커피를 가장 많이 재배하는 나라는?", "from": "e8f70600" },
  "data.quiz.rounds[1].questions[1].options": { "text": ["콜롬비아", "베트남", "브라질", "에티오피아"], "from": "9d51baba" },
  "data.quiz.rounds[1].questions[1].fact": { "text": "브라질은 세계 커피의 약 3분의 1을 재배해요.", "from": "e39c42f0" },
  "data.quiz.rounds[1].questions[2].q": { "text": "사프란은 식물의 어느 부분에서 나올까요?", "from": "a4527a58" },
  "data.quiz.rounds[1].questions[2].options": { "text": ["씨앗", "꽃의 암술머리", "나무껍질", "뿌리"], "from": "4d1cd5bb" },
  "data.quiz.rounds[1].questions[2].fact": { "text": "크로커스 꽃 한 송이에서 암술머리 세 개를 손으로 따요. 1킬로그램에 꽃 약 15만 송이가 필요해요.", "from": "b89fcd89" },
  "data.quiz.rounds[1].questions[3].q": { "text": "다음 중 파스타 종류가 아닌 것은?", "from": "967191f1" },
  "data.quiz.rounds[1].questions[3].options": { "text": ["오레키에테", "파르팔레", "아란치니", "파케리"], "from": "fa027bcf" },
  "data.quiz.rounds[1].questions[3].fact": { "text": "아란치니는 시칠리아의 속을 채워 튀긴 주먹밥이에요.", "from": "12e00d3d" },
  "data.quiz.rounds[2].theme": { "text": "과학과 자연", "from": "f7ec30f4" },
  "data.quiz.rounds[2].questions[0].q": { "text": "사람 몸에서 가장 큰 기관은?", "from": "d5d49137" },
  "data.quiz.rounds[2].questions[0].options": { "text": ["간", "뇌", "폐", "피부"], "from": "6181bc80" },
  "data.quiz.rounds[2].questions[0].fact": { "text": "어른의 피부는 무게가 약 4킬로그램이에요.", "from": "7a8c67a3" },
  "data.quiz.rounds[2].questions[1].q": { "text": "햇빛이 지구에 닿는 데 얼마나 걸릴까요?", "from": "746e1acb" },
  "data.quiz.rounds[2].questions[1].options": { "text": ["약 8초", "약 8분", "약 8시간", "약 하루"], "from": "7b70665f" },
  "data.quiz.rounds[2].questions[1].fact": { "text": "햇빛은 약 8분 20초 동안 이동해요. 그래서 우리는 언제나 조금 전의 태양을 보는 거예요.", "from": "7b21b831" },
  "data.quiz.rounds[2].questions[2].q": { "text": "심장이 세 개인 동물은?", "from": "30a233eb" },
  "data.quiz.rounds[2].questions[2].options": { "text": ["문어", "상어", "개구리", "불가사리"], "from": "d61ee5a7" },
  "data.quiz.rounds[2].questions[2].fact": { "text": "심장 두 개는 아가미로 피를 보내고, 세 번째 심장은 온몸으로 피를 보내요.", "from": "118cd81c" },
  "data.quiz.rounds[2].questions[3].q": { "text": "금의 원소 기호는?", "from": "06fa9b6f" },
  "data.quiz.rounds[2].questions[3].options": { "text": ["Go", "Gd", "Ag", "Au"], "from": "c2c1255f" },
  "data.quiz.rounds[2].questions[3].fact": { "text": "Au는 금을 뜻하는 라틴어 aurum에서 왔어요. argentum에서 온 Ag는 은이에요.", "from": "71738f6b" },
  "data.quiz.rounds[3].theme": { "text": "음악과 영화", "from": "b72b3462" },
  "data.quiz.rounds[3].questions[0].q": { "text": "일반 피아노의 건반은 몇 개일까요?", "from": "5283df33" },
  "data.quiz.rounds[3].questions[0].options": { "text": ["76", "88", "92", "100"], "from": "e2b7aa7e" },
  "data.quiz.rounds[3].questions[0].fact": { "text": "흰 건반 52개와 검은 건반 36개로, 7옥타브가 조금 넘어요.", "from": "4bd09ce0" },
  "data.quiz.rounds[3].questions[1].q": { "text": "앨범 Abbey Road를 낸 밴드는?", "from": "ccee2885" },
  "data.quiz.rounds[3].questions[1].options": { "text": ["The Rolling Stones", "Queen", "The Beatles", "Pink Floyd"], "from": "3847ad00" },
  "data.quiz.rounds[3].questions[1].fact": { "text": "밴드가 녹음한 런던의 거리 이름을 땄고, 1969년에 나왔어요.", "from": "657f8d2f" },
  "data.quiz.rounds[3].questions[2].q": { "text": "최초의 아카데미 작품상을 받은 영화는?", "from": "d80765cd" },
  "data.quiz.rounds[3].questions[2].options": { "text": ["날개", "카사블랑카", "메트로폴리스", "바람과 함께 사라지다"], "from": "d037ac36" },
  "data.quiz.rounds[3].questions[2].fact": { "text": "1차 세계대전 조종사들을 다룬 무성 영화 「날개」가 1929년 첫 시상식에서 상을 받았어요.", "from": "2f3a268a" },
  "data.quiz.rounds[3].questions[3].q": { "text": "악보에서 forte는 어떻게 연주하라는 뜻일까요?", "from": "3687b999" },
  "data.quiz.rounds[3].questions[3].options": { "text": ["느리게", "여리게", "세게", "마디 반복"], "from": "59d82c26" },
  "data.quiz.rounds[3].questions[3].fact": { "text": "forte는 이탈리아어로 '강하게'라는 뜻이에요. 반대말인 piano에서 악기 이름이 나왔어요.", "from": "75e1beb2" }
