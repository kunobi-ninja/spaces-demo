  "data.hiring.candidates[C1].source": { "text": "Segnalazione", "from": "db50958d" },
  "data.hiring.candidates[C1].scorecards[0].note": { "text": "Ha gestito un servizio clienti di 6 persone per un negozio di mobili. Il suo piano di escalation è il migliore che abbiamo visto.", "from": "38dfa505" },
  "data.hiring.candidates[C1].scorecards[1].note": { "text": "Bravissima con i clienti. Quando le ho chiesto come gestiva chi rende poco, la risposta è rimasta generica.", "from": "d9f083c2" },
  "data.hiring.candidates[C1].scorecards[2].note": { "text": "Il suo esercizio scritto era chiaro e gentile. Lavorerei volentieri con lei sui contenuti del centro assistenza.", "from": "94fe8013" },
  "data.hiring.candidates[C1].next.what": { "text": "Pranzo con il team dell'assistenza", "from": "af094e11" },
  "data.hiring.candidates[C2].source": { "text": "LinkedIn", "from": "de0fe4ad" },
  "data.hiring.candidates[C2].scorecards[0].note": { "text": "Calmo, ordinato e già pensa al nostro buco di copertura nel weekend.", "from": "ab416b7a" },
  "data.hiring.candidates[C2].scorecards[1].note": { "text": "Forte sui processi. Ha fatto buone domande su come misuriamo la qualità dell'assistenza.", "from": "c5e73ff0" },
  "data.hiring.candidates[C2].scorecards[2].note": { "text": "Facile parlarci. Ha dato esempi concreti di come riportare al prodotto i problemi dei clienti.", "from": "58f581b4" },
  "data.hiring.candidates[C2].next.what": { "text": "Chiamata per l'offerta: risposta sulla fascia di stipendio", "from": "b3668e08" },
  "data.hiring.candidates[C3].source": { "text": "Sito di annunci", "from": "adfa945c" },
  "data.hiring.candidates[C3].scorecards[0].note": { "text": "Ha scritto la risposta più chiara di tutti finora all'esercizio sul cliente arrabbiato.", "from": "14910db0" },
  "data.hiring.candidates[C3].scorecards[1].note": { "text": "La risposta era educata ma lunga. Non sono sicuro che reggerebbe in alta stagione.", "from": "e340824a" },
