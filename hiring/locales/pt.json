  "data.hiring.candidates[C1].source": { "text": "Indicação", "from": "db50958d" },
  "data.hiring.candidates[C1].scorecards[0].note": { "text": "Liderou uma equipe de suporte de 6 pessoas numa loja de móveis. O protocolo de escalonamento dela foi o melhor que já vimos.", "from": "38dfa505" },
  "data.hiring.candidates[C1].scorecards[1].note": { "text": "Ótima com clientes. Quando perguntei como lidou com alguém de baixo desempenho, a resposta ficou genérica.", "from": "d9f083c2" },
  "data.hiring.candidates[C1].scorecards[2].note": { "text": "O exercício escrito dela foi claro e gentil. Trabalharia com prazer com ela no conteúdo da central de ajuda.", "from": "94fe8013" },
  "data.hiring.candidates[C1].next.what": { "text": "Almoço com a equipe de suporte", "from": "af094e11" },
  "data.hiring.candidates[C2].source": { "text": "LinkedIn", "from": "de0fe4ad" },
  "data.hiring.candidates[C2].scorecards[0].note": { "text": "Calmo, organizado e já pensando em como cobrir os fins de semana.", "from": "ab416b7a" },
  "data.hiring.candidates[C2].scorecards[1].note": { "text": "Forte em processos. Fez boas perguntas sobre como medimos a qualidade do suporte.", "from": "c5e73ff0" },
  "data.hiring.candidates[C2].scorecards[2].note": { "text": "Fácil de conversar. Deu exemplos concretos de como levar as dores dos clientes para o produto.", "from": "58f581b4" },
