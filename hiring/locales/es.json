  "data.hiring.candidates[C1].scorecards[1].note": { "text": "Muy buena con los clientes. Cuando le pregunté cómo gestionó a alguien con bajo rendimiento, la respuesta se quedó en lo general.", "from": "d9f083c2" },
  "data.hiring.candidates[C1].scorecards[2].note": { "text": "Su ejercicio escrito fue claro y amable. Trabajaría encantada con ella en el contenido del centro de ayuda.", "from": "94fe8013" },
