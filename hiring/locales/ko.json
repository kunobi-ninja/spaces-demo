  "data.hiring.candidates[D2].scorecards[0].note": { "text": "생각이 명확하고, 타이포그래피가 아름다워요.", "from": "6bb5290b" },
  "data.hiring.candidates[D2].scorecards[1].note": { "text": "전체 과정에서 가장 좋은 질문을 했어요.", "from": "8cee79a3" },
