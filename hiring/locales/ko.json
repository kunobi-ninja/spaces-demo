  "data.hiring.candidates[D3].scorecards[1].note": { "text": "일부 시니어 지원자보다 트레이드오프를 더 잘 설명했어요.", "from": "25a30a58" },
  "data.hiring.candidates[D3].scorecards[2].note": { "text": "고객 지원 피드백 세션에 함께하기 쉬울 거예요.", "from": "c535204a" },
