  "data.hiring.candidates[C1].scorecards[0].note": { "text": "Hat ein 6-köpfiges Support-Team bei einem Möbelhändler geleitet. Ihr Eskalations-Playbook war das beste, das wir gesehen haben.", "from": "38dfa505" },
  "data.hiring.candidates[C1].scorecards[1].note": { "text": "Super mit Kunden. Als ich fragte, wie sie mit schwachen Leistungen umgeht, blieb die Antwort allgemein.", "from": "d9f083c2" },
  "data.hiring.candidates[C1].scorecards[2].note": { "text": "Ihre Schreibaufgabe war klar und freundlich. Würde gern mit ihr an Hilfe-Inhalten arbeiten.", "from": "94fe8013" },
