  "data.hiring.candidates[C2].scorecards[0].note": { "text": "沉稳、有条理，已经在考虑我们周末的人手缺口。", "from": "ab416b7a" },
  "data.hiring.candidates[C2].scorecards[1].note": { "text": "流程方面很强。问了关于我们如何衡量客服质量的好问题。", "from": "c5e73ff0" },
  "data.hiring.candidates[C2].scorecards[2].note": { "text": "很好沟通。举了具体例子，说明如何把客户痛点反馈给产品团队。", "from": "58f581b4" },
  "data.hiring.candidates[C2].next.what": { "text": "Offer 电话：答复薪资范围", "from": "b3668e08" },
