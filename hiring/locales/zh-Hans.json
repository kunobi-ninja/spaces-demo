  "data.hiring.candidates[C1].scorecards[0].note": { "text": "曾在一家家具零售商管理 6 人的客服团队。她的问题升级手册是我们见过最好的。", "from": "38dfa505" },
  "data.hiring.candidates[C1].scorecards[1].note": { "text": "和客户打交道很棒。问她如何处理表现不佳的员工时，回答比较笼统。", "from": "d9f083c2" },
  "data.hiring.candidates[C1].scorecards[2].note": { "text": "她的写作练习清晰又友善。很乐意和她一起做帮助中心的内容。", "from": "94fe8013" },
  "data.hiring.candidates[C1].next.what": { "text": "和客服团队一起吃午饭", "from": "af094e11" },
